# OpenVPN Web Panel — secret handling and defaults.
#
# Generated by `ovpn-panel gen-secrets`. Keep this file readable only by root
# and the `ovpn-panel` group (mode 600 / 640). Never commit it to version
# control.

# Flask/FastAPI session signing key. Rotating this invalidates all sessions.
OVPN_SECRET_KEY=change-me-at-install

# Token used by the OpenVPN hook scripts to call the panel's /hooks endpoints.
OVPN_HOOK_TOKEN=change-me-at-install

# Local unix socket used by OpenVPN's auth-user-pass-verify hook.
OVPN_AUTH_SOCKET=/run/ovpn-panel/auth.sock

# Panel listen port and admin user (written by the installer, read by the CLI).
OVPN_PANEL_PORT=8080
OVPN_ADMIN_USER=admin

# SQLite (default) or PostgreSQL.
OVPN_DATABASE_URL=sqlite:////var/lib/ovpn-panel/panel.sqlite3
# OVPN_DATABASE_URL=postgresql+psycopg://panel:password@127.0.0.1/ovpn_panel

# Secure cookies (disable only for plain-HTTP local testing).
OVPN_SESSION_SECURE=true

# Login rate limiting.
OVPN_LOGIN_MAX_ATTEMPTS=5
OVPN_LOGIN_WINDOW_SECONDS=300

# Host allow-list once a reverse proxy is configured.
OVPN_TRUSTED_HOSTS=["panel.example.com"]
